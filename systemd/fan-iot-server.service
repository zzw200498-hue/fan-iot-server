[Unit]
Description=Fan IoT TCP Server (STM32 telemetry + remote control)
After=network.target

[Service]
Type=simple
# 按需修改端口与数据库路径
ExecStart=/opt/fan-iot-server/fan-iot-server 9999 8080 /var/lib/fan/fan.db
WorkingDirectory=/opt/fan-iot-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
